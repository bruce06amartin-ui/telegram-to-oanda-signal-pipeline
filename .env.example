# Variable names and placeholder values. Export them in your shell or set them in your host's dashboard.
# NEVER commit real values. The program reads environment variables only (it does not load a .env file).
TG_API_ID=0
TG_API_HASH=your_telegram_api_hash
TG_SESSION=your_telegram_string_session        # made once with make_session.py; as powerful as a password
TG_CHATS=-1000000000000                        # chat id(s) or @username(s) to watch, comma separated
TG_TOPICS=                                     # optional: only forward these forum topic ids
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Signal bot (off unless SIGNAL_BOT=1)
SIGNAL_BOT=0
OANDA_DRY_RUN=1                                # 1 = log what it WOULD do; only 0 places PRACTICE orders
OANDA_API_TOKEN=your_oanda_practice_token
OANDA_ACCOUNT_ID=101-000-0000000-000           # V20 practice account ids start with 101-
BOT_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN   # private channel where the bot reports decisions
DATA_DIR=./data                                # bot state, decisions.jsonl, and the KILL file live here

# Optional "paper scoreboard" for the source channel
SOURCE_CHANNEL_ID=
SOURCE_BOARD_WEBHOOK_URL=
SOURCE_TARGET_TP=1
SOURCE_ENTRY=near
